# ─── Database (Neon Postgres) ─────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:...@ep-....aws.neon.tech/neondb?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-random-32-bytes

# ─── Encryption for stored tenant provider API keys (BYOK) ────────
# 32-byte key, base64. Provider API keys are AES-256-GCM encrypted at rest.
CREDENTIALS_ENCRYPTION_KEY=change-me-base64-32-bytes

# ─── Storage (Vercel Blob) ────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Default (platform) AI provider keys — tenants can BYOK ───────
# Used only when a tenant has NOT configured their own key (optional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ─── Seeded superadmin (created on first migrate) ─────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
